# Rotates the container logs of the estack instances. estack-logrotate.timer starts it.
# `estack-instance setup` installs it. See docs/docker.md#logs.
[Unit]
Description=Rotate the container logs of the estack instances

[Service]
Type=oneshot
ExecStart=/usr/sbin/logrotate --state /var/lib/logrotate/estack-docker.status /etc/estack-docker/logrotate.conf
