[Unit]
Description=estack %i (agents server)
After=network-online.target tailscaled.service estack-github-read.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=/etc/estack/instances/%i.env
ExecStart=/bin/sh -c 'exec ./estack/bin/estack-instance %i start'
ExecStop=/bin/sh -c 'exec ./estack/bin/estack-instance %i stop'
TimeoutStartSec=600
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target
