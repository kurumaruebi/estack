# Stages the newest release, or stops estack, moves the staged release into place and starts estack
# again, when an owner, an admin or a permitted member asks for it in Server Settings > Updates.
[Unit]
Description=Update estack on request
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=/opt/estack/hosted/estack-hosted-update request
# A download and an apply: the limits of estack-update.service and estack-update-apply.service.
TimeoutStartSec=45min
