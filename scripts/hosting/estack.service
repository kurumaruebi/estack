# estack on a hosted server. provision.sh replaces @SERVICE_USER@ and enables this unit. boat
# stop and resume work like a reboot, so the unit starts again on each wake. boat starts the desktop
# about 8 seconds before the enabled units, and estack starts with it.
[Unit]
Description=estack hosted server
Wants=network-online.target estack-update-apply.service
After=network-online.target display-manager.service
# estack-boat-pre-stop stops estack before boat saves the disk, and makes this file so that nothing
# starts it again before the save. /run is empty at each boot.
ConditionPathExists=!/run/estack-pre-stop

[Service]
Type=simple
User=@SERVICE_USER@
RuntimeDirectory=estack
RuntimeDirectoryMode=0700
Environment=XDG_RUNTIME_DIR=/run/estack
# As root (+), and estack starts when it fails (-). It repairs the modes of the release, and installs
# the update request units when an older release moved this one into place; estack-hosted-update
# says why.
ExecStartPre=-+/opt/estack/hosted/estack-hosted-update trigger
ExecStart=/opt/estack/hosted/estack-hosted-server
# Stops estack before its virtual displays, so that it closes its database first.
ExecStop=/opt/estack/hosted/estack-hosted-server --stop
Restart=always
RestartSec=10
# estack exits with 78 when it stops its start loop (src/main/server-start-halt.ts). It stays
# stopped until a restart, `estack update`, or `estack-hosted-update check` starts it again.
RestartPreventExitStatus=78
TimeoutStopSec=60
# Memory guards. The machine is small, and this unit holds estack, its browser tabs and every agent
# process. The OOM killer of the unit acts before the kernel's own, so the desktop, sshd and the boat
# agent keep running. systemd sets -500 as root, before it changes the user; main then gives each
# process it starts 500, so the OOM killer picks an agent process before main. One killed agent does
# not stop the unit: the default policy "stop" would stop estack too.
MemoryMax=90%
OOMScoreAdjust=-500
OOMPolicy=continue

[Install]
WantedBy=multi-user.target lightdm.service
