node_modules/
*.tsbuildinfo
out/
out-*/
dist/
apps/*/dist/
# The vendored bloub avatar package (packages/bloub) ships its built files; the repository owns them.
!packages/bloub/dist/
!packages/bloub/dist/**
apps/*/.wrangler/
apps/*/worker-configuration.d.ts
coverage/
.DS_Store
*.log
*.local
.env
.env.*
.dev.vars
.dev.vars.*
!.env.example
!apps/auth-api/.env.production
!apps/auth-api/.env.dev
!remote/.env.production
*.key
*.p12
*.pem
# The update signing certificate of the mobile app is public, and each binary has it. The EAS build
# copies the project with its own ignore logic: a file is left out when one `.gitignore` file ignores
# it, and the exception in `apps/mobile/.gitignore` does not count for the rule above. Without this
# line, the build has no certificate and `expo prebuild` stops.
!apps/mobile/certs/certificate.pem
.idea/
# Keep shared VS Code settings while ignoring other editor state.
**/.vscode/*
!/.vscode/settings.json
!/.vscode/extensions.json
!/apps/mobile/.vscode/settings.json
!/apps/mobile/.vscode/extensions.json
playwright-report/
test-results/
storybook-static/
Shared/
!apps/mobile/src/shared/
!apps/mobile/src/shared/**
index-*.css
.estack-browser-test/
.estack-build/
# The reports and traces of `bun run test:provider-live`. e2e keeps them beside its config.
/scripts/provider-live/.e2e/
# The home page beam, a laser-flow port whose license lets no public copy, is gone: the hero shows
# without it and no private component is referenced. This ignore stays so a stray copy cannot return.
/apps/auth-api/src/vendor/
.worktrees/
# Claude Code creates git worktrees here; they carry a nested biome.json.
.claude/worktrees/
.claude/settings.local.json
/build/cloudflared/
/build/cua-driver/
/build/codex/
/build/claude/
/build/grok/
/build/remote-desktop-runtime/
/build/remote-desktop-release/
Bots
# Local dev-profile agent workspaces; root only, so tracked */agents/ paths stay visible.
/Agents/
!apps/mobile/src/features/bots/
!apps/mobile/src/features/bots/**
mise.local.toml
# Local provider credential export. Never commit.
keys
# A Firebase service account key sends Android notifications. It goes into the encrypted account
# service settings only. Never commit.
*firebase-adminsdk*.json
# Firebase service configs of the mobile app. `app.config.js` reads the Android one from a path
# outside the repository (`ESTACK_GOOGLE_SERVICES_FILE`). Never commit.
google-services.json
GoogleService-Info.plist
# The instance-local VPS settings that `estack/bin/install-vps-instance` reads live outside the
# repository, in `/etc/estack/instances/<name>.env`. Never commit a copy here.
/estack/vps/instance.env
# Android signing credentials. Never commit.
*.keystore
key.properties
# Agent task checklist. Local to one worktree.
/TASKS.md
# The private planning notes moved outside the repository (2026-11-19). The public export also
# excludes this path, but a copy must never come back.
/estack/非公開/

# Persistent local development identity and migration recovery.
.estack/
